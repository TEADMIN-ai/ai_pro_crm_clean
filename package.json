{
  "name": "ai_pro_crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/envCheck.ts && tsc --noEmit && next build",
    "start": "next start",
    "clean": "rimraf .next",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "jest",
    "route": "npm run route:integrity",
    "route:integrity": "tsx scripts/routeIntegrityCheck.ts",
    "autofill:integrity": "tsx scripts/autofillIntegrityCheck.ts",
    "sanity": "tsx scripts/sanityCheck.ts",
    "manus:sanity": "tsx scripts/manusSanityCheck.ts",
    "prepare": "husky",
    "build:strict": "npm run clean && npm run typecheck && npm run lint && npm run route:integrity && next build",
    "deploy:guard": "npm run build:strict",
    "set:admin": "ts-node scripts/bootstrapAdminRole.ts"
  },
  "dependencies": {
    "firebase": "^10.12.0",
    "firebase-admin": "^13.6.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "next": "^16.1.6",
    "nodemailer": "^8.0.4",
    "openai": "^6.22.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.5.207",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^3.7.0",
    "resend": "^6.10.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.19.33",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.3",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "postcss": "^8.5.10",
    "rimraf": "^5.0.10",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
