{
  "name": "ai_pro_crm",
  "version": "1.0.0",
  "private": true,

  "scripts": {
    "dev": "next dev",

    "build": "next build",

    "start": "next start",

    "clean": "rimraf .next",

    "typecheck": "tsc --noEmit",

    "lint": "next lint",

    "test": "jest",

    "build:strict": "npm run clean && npm run typecheck && npm run lint && next build",

    "deploy:guard": "npm run build:strict",

    "set:admin": "ts-node scripts/bootstrapAdminRole.ts"
  },

  "dependencies": {
    "firebase": "^10.12.0",
    "firebase-admin": "^13.6.1",
    "jszip": "^3.10.1",
    "next": "^16.1.6",
    "openai": "^6.22.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^3.7.0",
    "uuid": "^13.0.0"
  },

  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.19.33",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",

    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.3",

    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",

    "rimraf": "^5.0.10",
    "tsx": "^4.21.0",

    "typescript": "^5.4.0"
  },

  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverage": false
  }
}