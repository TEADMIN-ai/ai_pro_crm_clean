import type { DealStage } from "../../types/deal";
export function normalizeDealStage(input: string): DealStage {
  switch (input) {
    case "draft":
      return "draft";

    case "pricing":
      return "pricing";

    case "manager_review":
      return "manager_review";

    case "submitted":
      return "submitted";

    case "won":
      return "won";

    case "lost":
      return "lost";

    default:
      // Fallback safely to draft if unknown
      return "draft";
  }
}