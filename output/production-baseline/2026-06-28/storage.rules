rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isPrivileged() {
      return request.auth != null
        && (
          request.auth.token.admin == true
          || request.auth.token.role in ["admin", "manager", "staff"]
        );
    }

    function isHygieneInternal() {
      return request.auth != null
        && request.auth.token.role in ["admin", "manager", "staff", "driver"];
    }

    match /contractors/{contractorId}/{allPaths=**} {
      allow read, write: if false;
    }

    match /tenders/{ownerUid}/{allPaths=**} {
      allow read, write: if false;
    }

    match /tenderPacks/{contractorId}/{allPaths=**} {
      allow read, write: if false;
    }

    match /tender-pack-tests/{contractorId}/{allPaths=**} {
      allow read, write: if false;
    }

    match /dealFiles/{companyId}/{dealId}/{allPaths=**} {
      allow read, write: if isPrivileged();
    }

    match /hygiene/evidence/{clientId}/{collectionId}/{allPaths=**} {
      allow read, write: if isHygieneInternal();
    }

    match /hygiene/signatures/{clientId}/{collectionId}/{allPaths=**} {
      allow read, write: if isHygieneInternal();
    }

    match /hygiene/compliance/{documentId}/{allPaths=**} {
      allow read, write: if isHygieneInternal();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
