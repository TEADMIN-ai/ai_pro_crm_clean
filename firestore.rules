rules_version = "2";

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return isSignedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : "guest";
    }

    function contractorId() {
      return isSignedIn() && request.auth.token.contractorId is string
        ? request.auth.token.contractorId
        : null;
    }

    function isPrivileged() {
      return role() in ["admin", "manager", "staff"];
    }

    function isHygieneInternal() {
      return role() in ["admin", "manager", "staff", "driver"];
    }

    function isHygieneAdmin() {
      return role() in ["admin", "manager"];
    }

    function isHygieneStaffMutation() {
      return role() in ["admin", "manager", "staff", "driver"];
    }

    function isContractorOwner(value) {
      return role() == "contractor" && contractorId() != null && contractorId() == value;
    }

    function isSupportedComplianceDocumentType(documentId) {
      return documentId in [
        "cipc",
        "bbbee",
        "taxClearance",
        "coida",
        "bankConfirmation"
      ];
    }

    function protectedUserFields() {
      return [
        "role",
        "contractorId",
        "admin",
        "authUid",
        "customClaims",
        "claims",
        "status"
      ];
    }

    function doesNotSetProtectedUserFields() {
      return !request.resource.data.keys().hasAny(protectedUserFields());
    }

    function doesNotModifyProtectedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields());
    }

    function canAccessDeal(data) {
      return isPrivileged() || isContractorOwner(data.contractorId);
    }

    function canAccessDocument(data) {
      return isPrivileged() || isContractorOwner(data.contractorId);
    }

    function canMutateDeal(data) {
      return isPrivileged()
        || (
          role() == "contractor"
          && contractorId() != null
          && data.contractorId == contractorId()
          && request.resource.data.contractorId == contractorId()
        );
    }

    match /deals/{dealId} {
      allow read: if isSignedIn() && canAccessDeal(resource.data);
      allow create: if isSignedIn() && canMutateDeal(request.resource.data);
      allow update, delete: if isSignedIn() && canMutateDeal(resource.data);

      match /documents/{docId} {
        allow read: if isSignedIn() && canAccessDeal(get(/databases/$(database)/documents/deals/$(dealId)).data);
        allow create, update, delete: if isSignedIn() && canMutateDeal(get(/databases/$(database)/documents/deals/$(dealId)).data);
      }

      match /activity/{activityId} {
        allow read, write: if isSignedIn() && canAccessDeal(get(/databases/$(database)/documents/deals/$(dealId)).data);
      }

      match /analytics/{docId} {
        allow read, write: if isSignedIn() && canAccessDeal(get(/databases/$(database)/documents/deals/$(dealId)).data);
      }
    }

    match /contractors/{docId} {
      allow read: if isSignedIn() && (isPrivileged() || isContractorOwner(docId));
      allow write: if false;

      match /documents/{documentId} {
        allow read: if isSignedIn() && (isPrivileged() || isContractorOwner(docId));
        allow create, update, delete: if isSignedIn()
          && isSupportedComplianceDocumentType(documentId)
          && (isPrivileged() || isContractorOwner(docId))
          && request.resource.data.contractorId == docId
          && request.resource.data.documentType == documentId;
      }
    }

    match /documents/{docId} {
      allow read: if isSignedIn() && canAccessDocument(resource.data);
      allow write: if false;
    }

    match /users/{docId} {
      allow read: if isSignedIn() && (request.auth.uid == docId || isPrivileged());
      allow create: if isSignedIn()
        && request.auth.uid == docId
        && doesNotSetProtectedUserFields();
      allow update: if isSignedIn()
        && request.auth.uid == docId
        && doesNotModifyProtectedUserFields();
      allow delete: if false;
    }

    match /tender_fixes/{docId} {
      allow read, write: if isSignedIn() && isPrivileged();
    }

    match /tenders/{docId} {
      allow read, write: if isSignedIn() && isPrivileged();
    }

    match /hygieneClients/{docId} {
      allow read: if isSignedIn() && isHygieneInternal();
      allow create, update, delete: if isSignedIn() && isHygieneAdmin();
    }

    match /hygieneSites/{docId} {
      allow read: if isSignedIn() && isHygieneInternal();
      allow create, update, delete: if isSignedIn() && isHygieneAdmin();
    }

    match /hygieneBinAssets/{docId} {
      allow read: if isSignedIn() && isHygieneInternal();
      allow create, update, delete: if isSignedIn() && isHygieneAdmin();
    }

    match /hygieneCollections/{docId} {
      allow read: if isSignedIn() && isHygieneInternal();
      allow create, update: if isSignedIn() && isHygieneStaffMutation();
      allow delete: if isSignedIn() && isHygieneAdmin();
    }

    match /hygieneManifests/{docId} {
      allow read: if isSignedIn() && isHygieneInternal();
      allow create, update: if isSignedIn() && isHygieneStaffMutation();
      allow delete: if isSignedIn() && isHygieneAdmin();
    }

    match /hygieneEvidence/{docId} {
      allow read: if isSignedIn() && isHygieneInternal();
      allow create, update: if isSignedIn() && isHygieneStaffMutation();
      allow delete: if isSignedIn() && isHygieneAdmin();
    }

    match /hygieneVehicleInspections/{docId} {
      allow read: if isSignedIn() && isHygieneInternal();
      allow create, update: if isSignedIn() && isHygieneStaffMutation();
      allow delete: if isSignedIn() && isHygieneAdmin();
    }

    match /hygieneDriverLogs/{docId} {
      allow read: if isSignedIn() && isHygieneInternal();
      allow create, update: if isSignedIn() && isHygieneStaffMutation();
      allow delete: if isSignedIn() && isHygieneAdmin();
    }

    match /hygieneComplianceDocuments/{docId} {
      allow read: if isSignedIn() && isHygieneInternal();
      allow create, update, delete: if isSignedIn() && isHygieneAdmin();
    }

    match /hygieneReports/{docId} {
      allow read: if isSignedIn() && isHygieneInternal();
      allow create, update, delete: if isSignedIn() && isHygieneAdmin();
    }

    match /hygieneJobEvents/{docId} {
      allow read: if isSignedIn() && isHygieneInternal();
      allow create: if isSignedIn() && isHygieneStaffMutation();
      allow update, delete: if isSignedIn() && isHygieneAdmin();
    }

    match /hygieneSignatures/{docId} {
      allow read: if isSignedIn() && isHygieneInternal();
      allow create: if isSignedIn() && isHygieneStaffMutation();
      allow update, delete: if isSignedIn() && isHygieneAdmin();
    }
  }
}
