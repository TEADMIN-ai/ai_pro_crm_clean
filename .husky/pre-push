#!/usr/bin/env sh

echo "[husky] pre-push sanity check"

if [ -f "dist/lib/sanityCheck.js" ]; then
  node dist/lib/sanityCheck.js || echo "[husky] built sanity check failed; allowing push"
elif [ -f "src/lib/sanityCheck.ts" ]; then
  npx --no-install tsx src/lib/sanityCheck.ts || echo "[husky] TypeScript sanity check failed or runner unavailable; allowing push"
else
  echo "[husky] sanityCheck entry not found; allowing push"
fi

exit 0
