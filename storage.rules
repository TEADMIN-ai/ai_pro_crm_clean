rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 🔒 Contractor Isolation
    match /contractors/{contractorId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == contractorId;
    }

    // 🧠 Admin Full Access
    match /{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.admin == true;
    }

  }
}